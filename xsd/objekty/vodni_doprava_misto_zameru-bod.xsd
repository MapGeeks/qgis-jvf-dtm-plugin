<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="vdmbod" xmlns:atr="atr" xmlns:cmn="cmn" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="vdmbod">
  <xs:import schemaLocation="../common/atributy.xsd" namespace="atr"/>
  <xs:import schemaLocation="../common/common.xsd" namespace="cmn"/>
  <xs:import schemaLocation="../ext/gml/gml.xsd" namespace="http://www.opengis.net/gml/3.2"/>
  <xs:element name="VodniDopravaMistoZameruBod" type="VodniDopravaMistoZameruBodType"/>
  <xs:complexType name="VodniDopravaMistoZameruBodType">
    <xs:sequence>
      <xs:element name="ObjektovyTypNazev" fixed="vodní doprava - místo záměru">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="code_base" type="xs:string" fixed="0100000344" use="required"/>
              <xs:attribute name="code_suffix" type="xs:string" fixed="01" use="required"/>
              <xs:attribute name="dim" type="xs:integer" fixed="2" use="prohibited"/>
              <xs:attribute name="gia" type="xs:boolean" fixed="0" use="prohibited"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <xs:sequence>
        <xs:element name="KategorieObjektu" type="xs:string" fixed="Záměry na provedení změn dopravní a technické infrastruktury">
          <xs:annotation>
            <xs:documentation>Kategorie objektu dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="SkupinaObjektu" type="xs:string" fixed="Záměr na provedení změn dopravní a technické infrastruktury">
          <xs:annotation>
            <xs:documentation>Skupina objektu dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ObsahovaCast" type="xs:string" fixed="DI">
          <xs:annotation>
            <xs:documentation>Zařazení objektu do obsahové části dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ZaznamyObjektu">
          <xs:annotation>
            <xs:documentation>Jednotlivé záznamy daného objektu</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="ZaznamObjektu" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ZaznamObjektu" abstract="true"/>
  <xs:element name="ZaznamObjektuRefN" type="RefN" substitutionGroup="ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuIns" type="Ins" substitutionGroup="ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuUpd" type="Upd" substitutionGroup="ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuDel" type="Del" substitutionGroup="ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuRefNIns" type="RefNIns" substitutionGroup="ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuRefNUpd" type="RefNUpd" substitutionGroup="ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuRefNDel" type="RefNDel" substitutionGroup="ZaznamObjektu"/>
  <xs:complexType name="RefN">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuRefType"/>
            <xs:element name="SpolecneAtributyObjektuZameru" type="atr:SpolecneAtributyObjektuZameruRefType"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod2DType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Ins">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuInsDTIType"/>
            <xs:element name="SpolecneAtributyObjektuZameru" type="atr:SpolecneAtributyObjektuZameruInsType"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod2DType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Upd">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuUpdDTIType"/>
            <xs:element name="SpolecneAtributyObjektuZameru" type="atr:SpolecneAtributyObjektuZameruUpdType" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod2DType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Del">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuDelType"/>
            <xs:element name="SpolecneAtributyObjektuZameru" type="atr:SpolecneAtributyObjektuZameruDelType" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod2DType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RefNIns">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuRefType"/>
            <xs:element name="SpolecneAtributyObjektuZameru" type="atr:SpolecneAtributyObjektuZameruRefType"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod2DType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RefNUpd">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuRefType"/>
            <xs:element name="SpolecneAtributyObjektuZameru" type="atr:SpolecneAtributyObjektuZameruRefType"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod2DType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RefNDel">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuRefDelType"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
