<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="stppol" xmlns:atr="atr" xmlns:cmn="cmn" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="stppol">
  <xs:import schemaLocation="../common/atributy.xsd" namespace="atr"/>
  <xs:import schemaLocation="../common/common.xsd" namespace="cmn"/>
  <xs:import schemaLocation="../ext/gml/gml.xsd" namespace="http://www.opengis.net/gml/3.2"/>
  <xs:element name="SterkovaPrehrazkaPlocha" type="SterkovaPrehrazkaPlochaType"/>
  <xs:complexType name="SterkovaPrehrazkaPlochaType">
    <xs:sequence>
      <xs:element name="ObjektovyTypNazev" fixed="štěrková přehrážka">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="code_base" type="xs:string" fixed="0100000333" use="required"/>
              <xs:attribute name="code_suffix" type="xs:string" fixed="03" use="required"/>
              <xs:attribute name="dim" type="xs:integer" fixed="3" use="prohibited"/>
              <xs:attribute name="gia" type="xs:boolean" fixed="0" use="prohibited"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <xs:sequence>
        <xs:element name="KategorieObjektu" type="xs:string" fixed="Vodní díla">
          <xs:annotation>
            <xs:documentation>Kategorie objektu dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="SkupinaObjektu" type="xs:string" fixed="Vzdouvací stavba">
          <xs:annotation>
            <xs:documentation>Skupina objektu dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ObsahovaCast" type="xs:string" fixed="ZPS">
          <xs:annotation>
            <xs:documentation>Zařazení objektu do obsahové části dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ZaznamyObjektu">
          <xs:annotation>
            <xs:documentation>Jednotlivé záznamy daného objektu</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="ZaznamObjektu" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ZaznamObjektu" abstract="true"/>
  <xs:element name="ZaznamObjektuRefV" type="RefV" substitutionGroup="ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuIns" type="Ins" substitutionGroup="ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuUpd" type="Upd" substitutionGroup="ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuDel" type="Del" substitutionGroup="ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuRefVIns" type="RefVIns" substitutionGroup="ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuRefVUpd" type="RefVUpd" substitutionGroup="ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuRefVDel" type="RefVDel" substitutionGroup="ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuPeIns" type="PeIns" substitutionGroup="ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuPeUpd" type="PeUpd" substitutionGroup="ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuPeDel" type="PeDel" substitutionGroup="ZaznamObjektu"/>
  <xs:complexType name="RefV">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuRefType"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSRefType"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuPlochaZPSType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Ins">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuInsZPSType" minOccurs="0"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSInsType"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuPlochaZPSType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Upd">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuUpdZPSType"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSUpdType" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuPlochaZPSType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Del">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuDelType"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSDelType" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuPlochaZPSType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RefVIns">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuRefType"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSRefType"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuPlochaZPSType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RefVUpd">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuRefType"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSRefType"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuPlochaZPSType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RefVDel">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuRefDelType"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="PeIns">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuPeType"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSInsType"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuPlochaZPSType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="PeUpd">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuPeType"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSUpdType" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuPlochaZPSType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="PeDel">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuPeType"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSDelType" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuPlochaZPSType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
